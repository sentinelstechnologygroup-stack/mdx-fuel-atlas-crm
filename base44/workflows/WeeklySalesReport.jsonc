{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_sales_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWeeklySalesReport",
            "args": {
              "timeRange": "this_week"
            }
          },
          "then": "email_summary",
          "x-base44": {
            "title": "Generate weekly report",
            "description": "From ReportConfig + export data"
          }
        }
      },
      {
        "email_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailReportSummary",
            "args": {
              "summary": "${ .generate_report.summary }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email summary to management",
            "description": "Send to sales management team"
          }
        }
      }
    ]
  },
  "description": "Every Monday: uses ReportConfig to generate a summary report, exports the report data to Excel, and emails the final summary to the sales management team.",
  "name": "Weekly Sales Report"
}