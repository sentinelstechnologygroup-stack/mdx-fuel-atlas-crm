{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Field key (e.g. 'favourite_color')"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "boolean",
        "select"
      ],
      "default": "text"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Lead",
        "Opportunity"
      ],
      "description": "Which entity this field belongs to"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Options for select type"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "label",
    "entity_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}