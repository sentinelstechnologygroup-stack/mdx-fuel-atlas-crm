{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Detailed message"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error",
        "task",
        "lead",
        "opportunity"
      ],
      "default": "info"
    },
    "related_entity_type": {
      "type": "string",
      "description": "e.g., Lead, Task, Opportunity"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of the related record"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "user_email": {
      "type": "string",
      "description": "Who is this notification for?"
    }
  },
  "required": [
    "title",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}