{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_lead_qualification",
      "version": "1.0",
      "namespace": "atlas"
    },
    "do": [
      {
        "score_lead": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scoreNewLead",
            "args": {
              "leadId": "${ .trigger.data.id }"
            }
          },
          "then": "check_score",
          "x-atlas": {
            "title": "Score new lead",
            "description": "SalesAssistant analyzes DiscoveryData"
          }
        }
      },
      {
        "check_score": {
          "switch": [
            {
              "when": "${ .score_lead.score >= 70 }",
              "then": "handle_high_score"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-atlas": {
            "title": "Is score high?",
            "description": "Threshold: 70+"
          }
        }
      },
      {
        "handle_high_score": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleHighScoreLead",
            "args": {
              "leadId": "${ .score_lead.leadId }",
              "leadName": "${ .score_lead.leadName }",
              "ownerEmail": "${ .score_lead.ownerEmail }",
              "score": "${ .score_lead.score }",
              "classification": "${ .score_lead.classification }",
              "reasoning": "${ .score_lead.reasoning }"
            }
          },
          "then": "end",
          "x-atlas": {
            "title": "Handle qualified lead",
            "description": "Create Task, notify owner, set Qualified"
          }
        }
      }
    ]
  },
  "description": "Triggers when a new Lead is created. The SalesAssistant analyzes the lead's DiscoveryData to score it. If the score is high, creates a Task for the owner, sends a notification, and updates the Lead status to Qualified.",
  "name": "New Lead Qualification"
}