{
  "name": "SalesTarget",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the sales rep"
    },
    "period": {
      "type": "string",
      "description": "Period identifier (e.g. '2025-Q1', '2025-01')"
    },
    "target_amount": {
      "type": "number",
      "description": "Revenue target for the period"
    }
  },
  "required": [
    "user_email",
    "target_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}